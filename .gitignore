# --- MATLAB / Simulink ---
slprj/
*.slxc
*.asv
*.autosave
*.mex*
*.slx.r20*
*.mdl.r20*
codegen/

# --- SolidWorks / Office temp + lock files ---
~$*
*.SLDBAK
*.tmp

# --- Firmware (PlatformIO / ESP32) ---
.pio/
.pioenvs/
.piolibdeps/
# Generated at build time by firmware/pack_web.py
firmware/src/web_page.h
firmware/src/web_assets.h
