# Regenerated gait time series. Summaries and plots in simulation/gait/results are tracked.
simulation/gait/results/*_body.csv
simulation/gait/results/*_contact.csv
simulation/gait/results/*_foot_paths_*.csv
simulation/gait/results/*_joint_*.csv
simulation/gait/results/*.mat
simulation/gait/results/*.slx
simulation/gait/trim/win_*/
# Local Wi-Fi credentials (copy wifi_secrets.example.h -> wifi_secrets.h)
wifi_secrets.h

# --- Build outputs ---
build/
*.exe
*.pdb
*.o
*.obj
compiler-cache/

# --- Node / Python ---
node_modules/
__pycache__/
*.pyc
.venv/

# --- Misc ---
*.log
tmp/
.DS_Store
Thumbs.db
desktop.ini
